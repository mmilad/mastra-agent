ASSISTANT_API=http://127.0.0.1:11434/v1
ASSISTANT_API_KEY=ollama
ASSISTANT_MODEL=qwen3.5:9b

# Allow enough agent steps for tool use plus a final answer (default 12)
# ASSISTANT_MAX_STEPS=12
# ASSISTANT_MAX_OUTPUT_TOKENS=4096

# Supervisor triage: LLM by default; set SUPERVISOR_TRIAGE_HEURISTIC_ONLY=1 to skip the extra model call
# SUPERVISOR_TRIAGE_TIMEOUT_MS=20000

# Claude ACP worker (optional): API key and/or `claude auth login` via the bundled Claude Code CLI
# ANTHROPIC_API_KEY=

# Cursor ACP worker — MUST be the Agent CLI, not the Cursor IDE (wrong binary opens tabs: agent, acp, enabled)
# CURSOR_AGENT_COMMAND=%LOCALAPPDATA%\cursor-agent\agent.cmd

# Optional Bearer token for POST /signal-intake when the HTTP adapter is wired into the Mastra server
# SIGNAL_INTAKE_TOKEN=

# In-workspace ACP permissions on delegated tasks auto-approve (default on). Set to false to always prompt.
# TASK_AUTO_APPROVE_IN_WORKSPACE=false

# minimal = delegate/status/approval/lookup only; full adds plantool, memory, skills
# ASSISTANT_TOOL_PROFILE=minimal

# Generate a user-visible summary after terminal worker_response (default on)
# WORKER_FOLLOWUP_GENERATE=false

# Optional GitHub CI webhook (POST /webhooks/github) — requires signature verification
# GITHUB_WEBHOOK_SECRET=
# GITHUB_DEFAULT_REPO=owner/repo
# GITHUB_DEFAULT_CONVERSATION_ID=
