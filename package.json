{
  "name": "minimal-mastra-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "chat": "node --env-file-if-exists=.env src/run.ts",
    "knowledge:index": "node --env-file-if-exists=.env src/knowledge/cli.ts",
    "check": "tsc --noEmit",
    "test:policy": "node --experimental-strip-types --test tests/policy/*.test.mjs",
    "test:context": "node --experimental-strip-types --test tests/context/*.test.mjs",
    "test:acp": "node --experimental-strip-types --test tests/acp/client.test.mjs",
    "test:acp:providers": "node --experimental-strip-types --test tests/acp/providers.test.mjs",
    "test:plantool": "node --experimental-strip-types --test tests/tools/*.test.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.112.0",
    "@agentclientprotocol/codex-acp": "2.10.0",
    "@libsql/client": "0.18.0",
    "@mastra/core": "1.85.0",
    "@mastra/duckdb": "^1.19.1",
    "@mastra/libsql": "^1.31.1",
    "@mastra/memory": "^1.41.2",
    "@mastra/observability": "^1.24.2",
    "@mastra/rag": "2.8.1",
    "@mastra/server": "1.85.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "mastra": "1.40.1",
    "typescript": "7.0.2"
  }
}
